# Choose one: gemini | openai | openai-compatible
AI_PROVIDER=gemini
# Gemini from Google AI Studio
GEMINI_API_KEY=
# OpenAI API (independently billed) — if using AI_PROVIDER=openai
OPENAI_API_KEY=
# OpenAI-compatible endpoint such as local Ollama, if using AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
PORT=5055
# Never share .env or connected WhatsApp/Gmail session files.
